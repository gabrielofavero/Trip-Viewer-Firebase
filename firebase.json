{
	"firestore": {
		"rules": "firestore.rules"
	},
	"hosting": {
		"public": "dist",
		"cleanUrls": true,
		"headers": [
			{
				"source": "**/*.@(js|css|png|jpg|jpeg|webp|svg|gif|ico|woff|woff2|ttf|otf|json)",
				"headers": [
					{
						"key": "Cache-Control",
						"value": "public, max-age=31536000, immutable"
					}
				]
			},
			{
				"source": "**/*.html",
				"headers": [
					{
						"key": "Cache-Control",
						"value": "no-cache, must-revalidate"
					}
				]
			},
			{
				"regex": "^/[^.]*$",
				"headers": [
					{
						"key": "Cache-Control",
						"value": "no-cache, must-revalidate"
					}
				]
			},
			{
				"source": "/version.json",
				"headers": [
					{
						"key": "Cache-Control",
						"value": "no-store, must-revalidate"
					}
				]
			}
		],
		"redirects": [
			{
				"source": "/viagem*",
				"destination": "/view",
				"type": 301
			},
			{
				"source": "/destinos*",
				"destination": "/destination",
				"type": 301
			},
			{
				"source": "/gastos*",
				"destination": "/expenses",
				"type": 301
			},
			{
				"source": "/editar-viagem*",
				"destination": "/edit/trip",
				"type": 301
			},
			{
				"source": "/editar-destino*",
				"destination": "/edit/destination",
				"type": 301
			},
			{
				"source": "/editar-listagem*",
				"destination": "/edit/listing",
				"type": 301
			}
		],
		"rewrites": [
			{
				"source": "**",
				"destination": "/index.html"
			}
		],
		"ignore": ["firebase.json", "**/.*", "**/node_modules/**"]
	},
	"emulators": {
		"auth": {
			"port": 9099
		},
		"firestore": {
			"port": 8085
		},
		"hosting": {
			"port": 5000
		},
		"functions": {
			"port": 5001
		},
		"ui": {
			"enabled": true
		},
		"singleProjectMode": true
	},
	"functions": [
		{
			"source": "functions",
			"codebase": "default",
			"ignore": [
				"node_modules",
				".git",
				"firebase-debug.log",
				"firebase-debug.*.log",
				"*.local"
			],
			"predeploy": ["npm --prefix \"$RESOURCE_DIR\" run build"]
		}
	]
}
