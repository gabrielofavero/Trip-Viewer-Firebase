# Build output
dist/

# Functions compiled output
functions/lib/

# Auto-generated backups
*-tripviewer-backup-*.json

# Dev
/dev/
tmp/

# Cloudflare Workers — local wrangler state (each workers/*/ also has its own
# .gitignore; this covers any stray leftover dir or ad-hoc run)
.wrangler/

# Logs
logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
firebase-debug.log*
firebase-debug.*.log*
package-lock.json
functions/package-lock.json

# Firebase cache
.firebase/

# Firebase emulator data (persisted between restarts)
.emulator-data/
.emulator-data-backups/
firebase-export-*/

# Python cache
__pycache__/

# Firebase config

# Uncomment this if you'd like others to create their own Firebase project.
# For a team working on the same Firebase project(s), it is recommended to leave
# it commented so all members can deploy to the same project(s) in .firebaserc.
# .firebaserc

# Runtime data
pids
*.pid
*.seed
*.pid.lock

# Directory for instrumented libs generated by jscoverage/JSCover
lib-cov

# Coverage directory used by tools like istanbul
coverage

# nyc test coverage
.nyc_output

# Grunt intermediate storage (http://gruntjs.com/creating-plugins#storing-task-files)
.grunt

# Bower dependency directory (https://bower.io/)
bower_components

# node-waf configuration
.lock-wscript

# Compiled binary addons (http://nodejs.org/api/addons.html)
build/Release

# Dependency directories
node_modules/

# Optional npm cache directory
.npm

# Optional eslint cache
.eslintcache

# Optional REPL history
.node_repl_history

# Output of 'npm pack'
*.tgz

# Yarn
yarn.lock
.yarn-integrity

# dotenv environment variables file
.env

# scripts info
scripts/export-maps-data/.env
scripts/export-maps-data/output.json
scripts/export-maps-data/input/*
!scripts/export-maps-data/input/.gitkeep
scripts/translation/results/*
scripts/gmaps-scraper/output/*
