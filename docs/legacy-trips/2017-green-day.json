    "extractionNotes": {
      "xlsxContent": "5 sheets: Suposições (cost scenarios for different city combos), Programação Prévia (detailed day-by-day schedule Nov 2-6 with 2 flight options for Nov 2), Voo (flight schedule comparison), Endereços (addresses + transit routes), Resultado (actual vs planned spending analysis). Final trip: São Paulo + Curitiba.",
      "docxContent": "Packing/todo checklist only.",
      "pdfHotelContent": "Granville Park Hotel, Curitiba. Reserved via hotel's official site. CID-encoded text, difficult to parse. Cost from spreadsheet: R$135.70 (dad paid R$271.39 actual).",
      "pdfFlightContent": "3 flights: BH→SP (Tam PDJHNL), SP→CWU (Tam SWDDPV), CWU→BH (Avianca U6HWC5).",
      "scenarioNote": "Spreadsheet had two versions for Nov 2: Voo Antecipado (early AM flight, full day in SP) vs Voo Mantido (afternoon flight). Used the Antecipado version (more complete data).",
      "actualVsPlanned": "Resultado sheet shows planned R$1,817.11 vs actual R$2,075.58. Personal share: R$1,582.91, Dad share: R$492.67."
    }
  },
