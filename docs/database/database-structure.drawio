                <mxCell id="usuarios-refs-label" value="&lt;b&gt;Lightweight refs (synced on every save by setUserData):&lt;/b&gt;" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;whiteSpace=wrap;rounded=0;fontSize=11;fontColor=#1a73e8;spacingLeft=4;" parent="1" vertex="1">
