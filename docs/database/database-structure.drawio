                <mxCell id="admin-body" value="&lt;b&gt;admin/admin&lt;/b&gt;&lt;br&gt;&amp;nbsp;&amp;nbsp;admins: string[] — Firebase Auth UIDs&lt;br&gt;&lt;br&gt;&lt;b&gt;admin/permissoes&lt;/b&gt;&lt;br&gt;&amp;nbsp;&amp;nbsp;tamanhoUploadIrrestrito: string[]&lt;br&gt;&amp;nbsp;&amp;nbsp;upload: string[]" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;whiteSpace=wrap;rounded=0;fontSize=11;fontColor=#555555;spacingLeft=4;" parent="1" vertex="1">
