                <mxCell id="protegido-body" value="&lt;b&gt;ProtectedDocument&lt;/b&gt;&lt;br&gt;&amp;nbsp;&amp;nbsp;pin: string — hashed PIN&lt;br&gt;&amp;nbsp;&amp;nbsp;compartilhamento: {ativo, dono}&lt;br&gt;&lt;br&gt;&lt;i&gt;PIN verification gate.&lt;br&gt;Read by loadPinData() before&lt;br&gt;serving viagens/protected or&lt;br&gt;gastos/protected.&lt;/i&gt;" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;whiteSpace=wrap;rounded=0;fontSize=10;fontColor=#333333;spacingLeft=4;" parent="1" vertex="1">
