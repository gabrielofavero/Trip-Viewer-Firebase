                </mxCell>
                <mxCell id="usuarios-note" value="Set via ops.update(`usuarios/${uid}`, …). Enables fast home-page listing without reading full trip/destination/listagem documents." style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;whiteSpace=wrap;rounded=0;fontSize=9;fontColor=#999999;spacingLeft=4;" parent="1" vertex="1">
                    <mxGeometry x="52" y="414" width="800" height="18" as="geometry"/>
                </mxCell>
                <mxCell id="viagens-box" value="" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e6f4ea;strokeColor=#34a853;arcSize=8;verticalAlign=top;align=left;spacingLeft=10;spacingTop=8;strokeWidth=2;" parent="1" vertex="1">
                    <mxGeometry x="40" y="520" width="580" height="360" as="geometry"/>
                </mxCell>
                <mxCell id="viagens-hdr" value="viagens / {tripId}" style="text;html=1;strokeColor=none;fillColor=#ceead6;align=center;verticalAlign=middle;whiteSpace=wrap;rounded=1;fontSize=15;fontStyle=1;fontColor=#1e8e3e;" parent="1" vertex="1">
                    <mxGeometry x="50" y="528" width="180" height="28" as="geometry"/>
                </mxCell>
                <mxCell id="viagens-body" value="&lt;b&gt;TripDocument&lt;/b&gt;&lt;br&gt;&lt;br&gt;&lt;b&gt;Core:&lt;/b&gt; titulo, moeda, inicio (DateObject|&quot;&quot;), fim (DateObject|&quot;&quot;)&lt;br&gt;&lt;b&gt;PIN:&lt;/b&gt; pin (&quot;no-pin&quot; | &quot;sensitive-only&quot; | &quot;all-data&quot;)&lt;br&gt;&lt;b&gt;Modules:&lt;/b&gt; modulos {hospedagens, destinos, gastos, programacao, resumo, transportes, galeria}&lt;br&gt;&lt;b&gt;Style:&lt;/b&gt; cores {ativo, claro, escuro}, imagem {ativo, background, claro, escuro}&lt;br&gt;&lt;b&gt;Visibility:&lt;/b&gt; visibilidade {claro, escuro}&lt;br&gt;&lt;br&gt;&lt;b&gt;Content:&lt;/b&gt;&lt;br&gt;&amp;nbsp;&amp;nbsp;destinos: {destinosID}[]&lt;br&gt;&amp;nbsp;&amp;nbsp;hospedagens: AccommodationItem[]&lt;br&gt;&amp;nbsp;&amp;nbsp;transportes: TransportationBlock | TransportVisibility&lt;br&gt;&amp;nbsp;&amp;nbsp;galeria: {descricoes[], categorias[], imagens[], titulos[]}&lt;br&gt;&amp;nbsp;&amp;nbsp;links: {ativo, attachments, drive, maps, pdf, ppt, sheet, vacina}&lt;br&gt;&amp;nbsp;&amp;nbsp;programacoes: ItineraryDay[]&lt;br&gt;&amp;nbsp;&amp;nbsp;pessoas: {id, nome}[]&lt;br&gt;&lt;br&gt;&lt;b&gt;Meta:&lt;/b&gt; compartilhamento {ativo, dono, editores?}, versao {ultimaAtualizacao}" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;whiteSpace=wrap;rounded=0;fontSize=10;fontColor=#333333;spacingLeft=4;" parent="1" vertex="1">
                    <mxGeometry x="50" y="560" width="560" height="310" as="geometry"/>
                </mxCell>
                <mxCell id="vprotect-box" value="" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fce8e6;strokeColor=#ea4335;arcSize=8;verticalAlign=top;align=left;spacingLeft=10;spacingTop=8;strokeWidth=2;dashed=1;" parent="1" vertex="1">
                    <mxGeometry x="750" y="510" width="340" height="230" as="geometry"/>
                </mxCell>
                <mxCell id="vprotect-hdr" value="viagens/protected/{pin}/{tripId}" style="text;html=1;strokeColor=none;fillColor=#f5c6c0;align=center;verticalAlign=middle;whiteSpace=wrap;rounded=1;fontSize=12;fontStyle=1;fontColor=#c5221f;" parent="1" vertex="1">
                    <mxGeometry x="760" y="518" width="290" height="28" as="geometry"/>
                </mxCell>
                <mxCell id="vprotect-body" value="&lt;b&gt;TripProtectedDocument&lt;/b&gt;&lt;br&gt;pin: PinPreference&lt;br&gt;&lt;br&gt;&lt;b&gt;When pin = &quot;sensitive-only&quot;:&lt;/b&gt;&lt;br&gt;&amp;nbsp;&amp;nbsp;hospedagens?: { id → {reserva, link} }&lt;br&gt;&amp;nbsp;&amp;nbsp;transportes?: { id → {reserva, link} }&lt;br&gt;&amp;nbsp;&amp;nbsp;(only reservation codes &amp; links protected)&lt;br&gt;&lt;br&gt;&lt;b&gt;When pin = &quot;all-data&quot;:&lt;/b&gt;&lt;br&gt;&amp;nbsp;&amp;nbsp;Full TripDocument lives here.&lt;br&gt;&amp;nbsp;&amp;nbsp;Main viagens/{id} becomes stripped stub." style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;whiteSpace=wrap;rounded=0;fontSize=10;fontColor=#333333;spacingLeft=4;" parent="1" vertex="1">
                    <mxGeometry x="760" y="550" width="320" height="180" as="geometry"/>
                </mxCell>
                <mxCell id="stripped-box" value="" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fce8e6;strokeColor=#ea4335;arcSize=8;verticalAlign=top;align=left;spacingLeft=10;spacingTop=8;strokeWidth=1;dashed=1;" parent="1" vertex="1">
                    <mxGeometry x="670" y="790" width="340" height="160" as="geometry"/>
                </mxCell>
                <mxCell id="stripped-hdr" value="viagens/{id}  when pin=&quot;all-data&quot;" style="text;html=1;strokeColor=none;fillColor=#f5c6c0;align=center;verticalAlign=middle;whiteSpace=wrap;rounded=1;fontSize=11;fontStyle=1;fontColor=#c5221f;" parent="1" vertex="1">
                    <mxGeometry x="680" y="798" width="290" height="26" as="geometry"/>
                </mxCell>
                <mxCell id="stripped-body" value="&lt;b&gt;TripStrippedDocument&lt;/b&gt; — minimal stub&lt;br&gt;&lt;br&gt;✅ &lt;b&gt;Kept:&lt;/b&gt; titulo, moeda, inicio, fim, pin, cores,&lt;br&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;imagem, compartilhamento, versao, destinos&lt;br&gt;&lt;br&gt;❌ &lt;b&gt;Stubbed:&lt;/b&gt;&lt;br&gt;&amp;nbsp;&amp;nbsp;hospedagens → []&lt;br&gt;&amp;nbsp;&amp;nbsp;transportes → {claro, escuro} (visibility only)&lt;br&gt;&amp;nbsp;&amp;nbsp;galeria, links, modulos, pessoas,&lt;br&gt;&amp;nbsp;&amp;nbsp;programacoes, visibilidade → {}" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;whiteSpace=wrap;rounded=0;fontSize=9;fontColor=#333333;spacingLeft=4;" parent="1" vertex="1">
                    <mxGeometry x="680" y="828" width="320" height="112" as="geometry"/>
