                <mxCell id="gastos-hdr" value="gastos / {tripId}" style="text;html=1;strokeColor=none;fillColor=#e1bee7;align=center;verticalAlign=middle;whiteSpace=wrap;rounded=1;fontSize=13;fontStyle=1;fontColor=#7b1fa2;" parent="1" vertex="1">
                    <mxGeometry x="50" y="928" width="180" height="26" as="geometry"/>
                </mxCell>
                <mxCell id="gastos-body" value="&lt;b&gt;ExpensesDocument&lt;/b&gt;&lt;br&gt;&amp;nbsp;&amp;nbsp;compartilhamento: SharingInfo&lt;br&gt;&amp;nbsp;&amp;nbsp;moeda: string&lt;br&gt;&amp;nbsp;&amp;nbsp;pessoas: {id, nome}[]&lt;br&gt;&amp;nbsp;&amp;nbsp;versao: {ultimaAtualizacao}&lt;br&gt;&amp;nbsp;&amp;nbsp;gastosPrevios: ExpenseItem[]&lt;br&gt;&amp;nbsp;&amp;nbsp;gastosDurante: ExpenseItem[]&lt;br&gt;&lt;br&gt;&lt;b&gt;ExpenseItem:&lt;/b&gt; { nome, tipo, moeda, valor, pessoa? }&lt;br&gt;&lt;br&gt;📌 &lt;i&gt;With PIN → gastos/protected/{pin}/{tripId}&lt;/i&gt;" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;whiteSpace=wrap;rounded=0;fontSize=10;fontColor=#333333;spacingLeft=4;" parent="1" vertex="1">
