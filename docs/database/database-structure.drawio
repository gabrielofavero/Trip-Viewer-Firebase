                    <mxGeometry x="1070" y="1018" width="130" height="26" as="geometry"/>
                </mxCell>
                <mxCell id="subtypes-body" value="&lt;b&gt;AccommodationItem&lt;/b&gt;&lt;br&gt;cafe, datas{checkin, checkout}, descricao,&lt;br&gt;endereco, id, imagens[{descricao, link}],&lt;br&gt;reserva, link, nome&lt;br&gt;&lt;br&gt;&lt;b&gt;TransportationBlock&lt;/b&gt;&lt;br&gt;visualizacao: &quot;people-view&quot;|&quot;leg-view&quot;|&quot;simple-view&quot;&lt;br&gt;dados: TransportationItem[]&lt;br&gt;&lt;br&gt;&lt;b&gt;TransportationItem&lt;/b&gt;&lt;br&gt;datas{chegada, partida}, duracao, empresa,&lt;br&gt;id, idaVolta (&quot;ida&quot;|&quot;volta&quot;|&quot;durante&quot;),&lt;br&gt;link, pontos{chegada, partida},&lt;br&gt;reserva, transporte, pessoa" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;whiteSpace=wrap;rounded=0;fontSize=9;fontColor=#555555;spacingLeft=4;" parent="1" vertex="1">
