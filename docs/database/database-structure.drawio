                <mxCell id="legend-body" value="&lt;font color=&quot;#4285f4&quot;&gt;&lt;b&gt;Blue&lt;/b&gt;&lt;/font&gt; = User profile (central index)&lt;br&gt;&lt;font color=&quot;#34a853&quot;&gt;&lt;b&gt;Green&lt;/b&gt;&lt;/font&gt; = Trips (viagens)&lt;br&gt;&lt;font color=&quot;#ea4335&quot;&gt;&lt;b&gt;Red&lt;/b&gt;&lt;/font&gt; (dashed) = PIN-protected / encrypted&lt;br&gt;&lt;font color=&quot;#ab47bc&quot;&gt;&lt;b&gt;Purple&lt;/b&gt;&lt;/font&gt; = Expenses (gastos)&lt;br&gt;&lt;font color=&quot;#00897b&quot;&gt;&lt;b&gt;Teal&lt;/b&gt;&lt;/font&gt; = Destinations (destinos)&lt;br&gt;&lt;font color=&quot;#f9a825&quot;&gt;&lt;b&gt;Amber&lt;/b&gt;&lt;/font&gt; = Listings (listagens)&lt;br&gt;── &lt;b&gt;Solid arrow&lt;/b&gt; = ownership / FK&lt;br&gt;- - &lt;b&gt;Dashed arrow&lt;/b&gt; = PIN-protected path" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;whiteSpace=wrap;rounded=0;fontSize=11;fontColor=#444444;spacingLeft=4;" parent="1" vertex="1">
