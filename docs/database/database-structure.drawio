                <mxCell id="destinos-hdr" value="destinos / {destinationId}" style="text;html=1;strokeColor=none;fillColor=#b2dfdb;align=center;verticalAlign=middle;whiteSpace=wrap;rounded=1;fontSize=13;fontStyle=1;fontColor=#00695c;" parent="1" vertex="1">
                    <mxGeometry x="470" y="1018" width="220" height="26" as="geometry"/>
                </mxCell>
                <mxCell id="destinos-body" value="&lt;b&gt;DestinationDocument&lt;/b&gt;&lt;br&gt;&amp;nbsp;&amp;nbsp;titulo, moeda, myMaps&lt;br&gt;&amp;nbsp;&amp;nbsp;modulos: {restaurantes, mapa, saidas, turismo, lojas, lanches}&lt;br&gt;&amp;nbsp;&amp;nbsp;compartilhamento, versao&lt;br&gt;&lt;br&gt;&amp;nbsp;&amp;nbsp;restaurantes: Record&amp;lt;id, DestinationItem&amp;gt;&lt;br&gt;&amp;nbsp;&amp;nbsp;lanches: Record&amp;lt;id, DestinationItem&amp;gt;&lt;br&gt;&amp;nbsp;&amp;nbsp;saidas: Record&amp;lt;id, DestinationItem&amp;gt;&lt;br&gt;&amp;nbsp;&amp;nbsp;turismo: Record&amp;lt;id, DestinationItem&amp;gt;&lt;br&gt;&amp;nbsp;&amp;nbsp;lojas: Record&amp;lt;id, DestinationItem&amp;gt;&lt;br&gt;&lt;br&gt;&lt;b&gt;DestinationItem:&lt;/b&gt; { novo, criadoEm, nome, emoji,&lt;br&gt;&amp;nbsp;&amp;nbsp;descricao{pt,en}, website, instagram, regiao,&lt;br&gt;&amp;nbsp;&amp;nbsp;mapa, midia, nota, valor }" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;whiteSpace=wrap;rounded=0;fontSize=10;fontColor=#333333;spacingLeft=4;" parent="1" vertex="1">
