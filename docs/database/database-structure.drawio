                <mxCell id="listagens-body" value="&lt;b&gt;ListingDocument&lt;/b&gt;&lt;br&gt;&amp;nbsp;&amp;nbsp;titulo, subtitulo, descricao&lt;br&gt;&amp;nbsp;&amp;nbsp;destinos: {destinosID}[]&lt;br&gt;&amp;nbsp;&amp;nbsp;cores: {ativo, claro, escuro}&lt;br&gt;&amp;nbsp;&amp;nbsp;imagem: {background{caminho,link,nome},&lt;br&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;ativo, escuro, altura, claro}&lt;br&gt;&amp;nbsp;&amp;nbsp;links: {ativo, attachments, drive, maps,&lt;br&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;pdf, ppt, sheet, vacina}&lt;br&gt;&amp;nbsp;&amp;nbsp;compartilhamento: SharingInfo&lt;br&gt;&amp;nbsp;&amp;nbsp;versao: {ultimaAtualizacao, exibirEmDestinos}" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;whiteSpace=wrap;rounded=0;fontSize=10;fontColor=#333333;spacingLeft=4;" parent="1" vertex="1">
