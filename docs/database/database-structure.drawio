                <mxCell id="usuarios-hdr" value="usuarios / {uid}  ⬅  central index — lightweight copies of all user-owned documents" style="text;html=1;strokeColor=none;fillColor=#d2e3fc;align=center;verticalAlign=middle;whiteSpace=wrap;rounded=1;fontSize=15;fontStyle=1;fontColor=#1a73e8;" parent="1" vertex="1">
