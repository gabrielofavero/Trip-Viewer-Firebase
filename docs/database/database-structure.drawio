                </mxCell>
                <mxCell id="usuarios-core" value="&lt;b&gt;Core fields:&lt;/b&gt;&lt;br&gt;&amp;nbsp;&amp;nbsp;nome: string&lt;br&gt;&amp;nbsp;&amp;nbsp;foto: string&lt;br&gt;&amp;nbsp;&amp;nbsp;visibilidade: &quot;light&quot; | &quot;dark&quot; | &quot;auto&quot;&lt;br&gt;&amp;nbsp;&amp;nbsp;permissoes: { admin, tamanhoUploadIrrestrito, upload }" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;whiteSpace=wrap;rounded=0;fontSize=11;fontColor=#333333;spacingLeft=4;" parent="1" vertex="1">
                    <mxGeometry x="52" y="316" width="340" height="74" as="geometry"/>
