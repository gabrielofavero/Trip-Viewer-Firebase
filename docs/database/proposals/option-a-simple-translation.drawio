<mxfile host="app.diagrams.net" modified="2026-06-14T00:00:00.000Z" agent="Copilot" version="22.0.0">
  <diagram name="Option A - Simple Translation" id="option-a">
    <mxGraphModel dx="1200" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1400" pageHeight="1000" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />

        <!-- Title -->
        <mxCell id="title" value="Option A — Simple Translation (same structure, English names)" style="text;html=1;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;whiteSpace=wrap;rounded=0;fontSize=18;fontStyle=1" vertex="1" parent="1">
          <mxGeometry x="200" y="20" width="800" height="40" as="geometry" />
        </mxCell>

        <!-- ===== COLLECTIONS ROW ===== -->
        <mxCell id="label-collections" value="Firestore Collections" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;whiteSpace=wrap;rounded=0;fontSize=14;fontStyle=1" vertex="1" parent="1">
          <mxGeometry x="30" y="80" width="200" height="30" as="geometry" />
        </mxCell>

        <!-- users collection -->
        <mxCell id="users" value="users/{uid}&lt;br&gt;&lt;br&gt;• visibility (string)&lt;br&gt;• permissions (object)&lt;br&gt;&lt;br&gt;&lt;b&gt;trips&lt;/b&gt;: {id: {title, start, end,&lt;br&gt;  image, colors, version, pin, modules}}&lt;br&gt;&lt;br&gt;&lt;b&gt;destinations&lt;/b&gt;: {id: {title, currency, version}}&lt;br&gt;&lt;br&gt;&lt;b&gt;listings&lt;/b&gt;: {id: {title, subtitle,&lt;br&gt;  description, image, colors, version}}" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=11;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;" vertex="1" parent="1">
          <mxGeometry x="30" y="120" width="280" height="180" as="geometry" />
        </mxCell>

        <!-- trips collection -->
        <mxCell id="trips" value="trips/{id}&lt;br&gt;&lt;br&gt;• title, start, end, currency, pin&lt;br&gt;• version: {lastUpdated}&lt;br&gt;• colors: {light, dark, active}&lt;br&gt;• sharing: {owner, active, editors}&lt;br&gt;• modules: {...booleans}&lt;br&gt;• visibility: {light, dark}&lt;br&gt;&lt;br&gt;🔴 &lt;b&gt;destinations&lt;/b&gt;: [{id, &lt;i&gt;full dest. object&lt;/i&gt;}]&lt;br&gt;&lt;i&gt;  (embedded — N+1 reads!)&lt;/i&gt;&lt;br&gt;&lt;br&gt;🟡 &lt;b&gt;accommodations&lt;/b&gt;: [{name, dates,&lt;br&gt;  images[], reservation, ...}]&lt;br&gt;&lt;br&gt;🟡 &lt;b&gt;transportation&lt;/b&gt;: {viewMode,&lt;br&gt;  legs: [{type, direction, dates, ...}]}&lt;br&gt;&lt;br&gt;🟡 &lt;b&gt;schedule&lt;/b&gt;: [{date, earlyMorning,&lt;br&gt;  morning, afternoon, night}]&lt;br&gt;&lt;br&gt;🟡 &lt;b&gt;gallery&lt;/b&gt;: {categories, images, ...}&lt;br&gt;🟡 &lt;b&gt;links&lt;/b&gt;: {maps, drive, vaccine, ...}&lt;br&gt;🟡 &lt;b&gt;travelers&lt;/b&gt;: [{id, name}]" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=10;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;" vertex="1" parent="1">
          <mxGeometry x="340" y="120" width="320" height="310" as="geometry" />
        </mxCell>

        <!-- destinations collection -->
        <mxCell id="destinations" value="destinations/{id}&lt;br&gt;&lt;br&gt;• title, currency&lt;br&gt;• version: {lastUpdated}&lt;br&gt;• sharing: {owner, active}&lt;br&gt;• modules: {nightlife, restaurants,&lt;br&gt;  shops, attractions, snacks, map}&lt;br&gt;• myMaps (string)&lt;br&gt;&lt;br&gt;🔴 &lt;b&gt;restaurants&lt;/b&gt;: {id: {name,&lt;br&gt;  description:{pt,en}, rating, price,&lt;br&gt;  map, emoji, media, ...}}&lt;br&gt;🔴 &lt;b&gt;snacks&lt;/b&gt;: {...same shape}&lt;br&gt;🔴 &lt;b&gt;shops&lt;/b&gt;: {...same shape}&lt;br&gt;🔴 &lt;b&gt;nightlife&lt;/b&gt;: {...same shape}&lt;br&gt;🔴 &lt;b&gt;attractions&lt;/b&gt;: {...same shape}" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=10;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;" vertex="1" parent="1">
          <mxGeometry x="690" y="120" width="300" height="220" as="geometry" />
        </mxCell>

        <!-- listings collection -->
        <mxCell id="listings" value="listings/{id}&lt;br&gt;&lt;br&gt;• title, subtitle, description&lt;br&gt;• image, colors, version&lt;br&gt;• destinationRefs, tripRefs&lt;br&gt;• modules, sharing" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=11;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;" vertex="1" parent="1">
          <mxGeometry x="690" y="360" width="300" height="100" as="geometry" />
        </mxCell>

        <!-- expenses collection -->
        <mxCell id="expenses" value="expenses/{tripId}&lt;br&gt;&lt;br&gt;• duringTrip: ExpenseEntry[]&lt;br&gt;• preTrip: ExpenseEntry[]&lt;br&gt;• budget: object" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=11;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;" vertex="1" parent="1">
          <mxGeometry x="30" y="340" width="280" height="90" as="geometry" />
        </mxCell>

        <!-- protected collection -->
        <mxCell id="protected" value="protected/{tripId}&lt;br&gt;&lt;br&gt;• pin: string&lt;br&gt;&lt;br&gt;── Subcollections ──&lt;br&gt;trips/protected/{pin}/{tripId}&lt;br&gt;  → sensitive accomm. + transport data&lt;br&gt;expenses/protected/{pin}/{tripId}&lt;br&gt;  → protected expense data" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=10;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;" vertex="1" parent="1">
          <mxGeometry x="30" y="460" width="280" height="110" as="geometry" />
        </mxCell>

        <!-- config -->
        <mxCell id="config" value="config/system&lt;br&gt;&lt;br&gt;• registrationOpen: boolean&lt;br&gt;• ..." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontSize=11;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;" vertex="1" parent="1">
          <mxGeometry x="690" y="480" width="200" height="70" as="geometry" />
        </mxCell>

        <!-- ===== ISSUES CALLOUT ===== -->
        <mxCell id="issues-box" value="" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f9f2f2;strokeColor=#cc0000;strokeWidth=2;dashed=1;" vertex="1" parent="1">
          <mxGeometry x="340" y="460" width="320" height="130" as="geometry" />
        </mxCell>
        <mxCell id="issues-title" value="⚠️  Issues Preserved (0 of 12 fixed)" style="text;html=1;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;whiteSpace=wrap;rounded=0;fontSize=12;fontStyle=1;fontColor=#cc0000;" vertex="1" parent="1">
          <mxGeometry x="350" y="465" width="300" height="25" as="geometry" />
        </mxCell>
        <mxCell id="issues-list" value="🔴 N+1 destination reads (embedded in trip)&lt;br&gt;🔴 Unbounded parallel backup reads&lt;br&gt;🟠 Sequential protected reads on delete&lt;br&gt;🟠 Redundant onAuthStateChanged listeners&lt;br&gt;🟡 Unbounded user document growth&lt;br&gt;🟡 No offline persistence&lt;br&gt;🟡 getUserData race condition" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;whiteSpace=wrap;rounded=0;fontSize=10;" vertex="1" parent="1">
          <mxGeometry x="350" y="490" width="300" height="95" as="geometry" />
        </mxCell>

        <!-- ===== ARROWS ===== -->
