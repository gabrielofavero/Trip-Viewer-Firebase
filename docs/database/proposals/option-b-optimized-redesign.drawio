        <!-- ==================== KEY METRIC ==================== -->
        <mxCell id="metric-box" value="" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e8f5e9;strokeColor=#009900;strokeWidth=2;" vertex="1" parent="1">
          <mxGeometry x="1020" y="120" width="320" height="100" as="geometry" />
        </mxCell>
        <mxCell id="metric-title" value="📊  Trip Detail View — Read Comparison" style="text;html=1;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;whiteSpace=wrap;rounded=0;fontSize=12;fontStyle=1;fontColor=#009900;" vertex="1" parent="1">
          <mxGeometry x="1030" y="125" width="300" height="25" as="geometry" />
        </mxCell>
        <mxCell id="metric-body" value="&lt;b&gt;Before:&lt;/b&gt; 11 sequential reads ~ 0.5–2s&lt;br&gt;  (1 trip + 10 destinations via N+1)&lt;br&gt;&lt;b&gt;After:&lt;/b&gt; 14 parallel reads ~ 50–200ms&lt;br&gt;  (1 trip + 10 destinations + 3 subcoll.)&lt;br&gt;&lt;br&gt;🏁 &lt;b&gt;~80–90% latency reduction&lt;/b&gt;" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;whiteSpace=wrap;rounded=0;fontSize=10" vertex="1" parent="1">
          <mxGeometry x="1030" y="150" width="300" height="65" as="geometry" />
        </mxCell>

