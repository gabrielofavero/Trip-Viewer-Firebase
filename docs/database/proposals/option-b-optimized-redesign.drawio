        <mxCell id="trip-subs-label" value="trips/{id}/ (subcollections)  —  was all embedded in the trip document" style="text;html=1;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;whiteSpace=wrap;rounded=0;fontSize=11;fontStyle=1;fontColor=#d6b656;" vertex="1" parent="1">
          <mxGeometry x="340" y="575" width="640" height="20" as="geometry" />
        </mxCell>

        <mxCell id="trip-accoms" value="🆕 &lt;b&gt;accommodations/{accId}&lt;/b&gt;&lt;br&gt;{name, description, address,&lt;br&gt; dates: {checkIn, checkOut},&lt;br&gt; breakfast, images[], reservation, link}&lt;br&gt;&lt;i&gt;Independent reads, updates&lt;/i&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=10;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;" vertex="1" parent="1">
          <mxGeometry x="340" y="600" width="200" height="105" as="geometry" />
        </mxCell>
        <mxCell id="trip-transport" value="🆕 &lt;b&gt;transportation/{legId}&lt;/b&gt;&lt;br&gt;{type: &quot;flight&quot;|&quot;bus&quot;|&quot;car&quot;,&lt;br&gt; company, points: {origin, destination},&lt;br&gt; dates: {departure, arrival},&lt;br&gt; direction: &quot;outbound&quot;|&quot;return&quot;|&quot;during&quot;,&lt;br&gt; duration, reservation, link, person}&lt;br&gt;&lt;br&gt;🆕 &lt;b&gt;transportation/_settings&lt;/b&gt;&lt;br&gt;{viewMode: &quot;simple&quot; | &quot;leg&quot;}" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=10;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;" vertex="1" parent="1">
          <mxGeometry x="555" y="600" width="210" height="130" as="geometry" />
        </mxCell>
        <mxCell id="trip-schedule" value="🆕 &lt;b&gt;schedule/{dayId}&lt;/b&gt;&lt;br&gt;{title: {value, showDestinations,&lt;br&gt;  translate}, date, destinationIds,&lt;br&gt;  earlyMorning: PeriodItem[],&lt;br&gt;  morning, afternoon, night}&lt;br&gt;&lt;br&gt;&lt;i&gt;Each day = 1 doc, lazy-load&lt;/i&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=10;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;" vertex="1" parent="1">
          <mxGeometry x="780" y="600" width="200" height="130" as="geometry" />
        </mxCell>

        <!-- ==================== FIXED ISSUES CALLOUT ==================== -->
        <mxCell id="fixed-box" value="" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f0f9f0;strokeColor=#009900;strokeWidth=2;dashed=1;" vertex="1" parent="1">
          <mxGeometry x="330" y="770" width="660" height="135" as="geometry" />
        </mxCell>
        <mxCell id="fixed-title" value="✅  Issues Fixed (11 of 12)" style="text;html=1;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;whiteSpace=wrap;rounded=0;fontSize=13;fontStyle=1;fontColor=#009900;" vertex="1" parent="1">
          <mxGeometry x="340" y="775" width="640" height="25" as="geometry" />
        </mxCell>
        <mxCell id="fixed-list" value="✅ N+1 destination reads → parallel Promise.all() with {id} refs&lt;br&gt;✅ Unbounded backup reads → subcollections naturally chunked&lt;br&gt;✅ Sequential protected reads → parallel collection group queries&lt;br&gt;✅ Restore massive batches → subcollection restore is naturally chunked&lt;br&gt;✅ Redundant auth listeners → consolidate during migration&lt;br&gt;✅ Unbounded user doc → slim profile + summary subcollections&lt;br&gt;✅ getUserData race → promise deduplication pattern&lt;br&gt;✅ No offline persistence → added during migration (enablePersistence)" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;whiteSpace=wrap;rounded=0;fontSize=10;" vertex="1" parent="1">
          <mxGeometry x="340" y="798" width="640" height="105" as="geometry" />
        </mxCell>

        <!-- ==================== ARROWS ==================== -->
        <!-- user → tripSummaries -->
        <mxCell id="arr-user-summaries" value="🆕 subcollection" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;fontSize=9;fontColor=#009900;strokeColor=#009900;" edge="1" parent="1" source="users" target="user-trip-summaries">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <!-- trip → accommodations subcollection -->
        <mxCell id="arr-trip-accoms" value="🆕 subcollection" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;fontSize=9;fontColor=#009900;strokeColor=#009900;" edge="1" parent="1" source="trips" target="trip-accoms">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <!-- trip → transportation subcollection -->
        <mxCell id="arr-trip-transport" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;exitX=1;exitY=0.85;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;fontSize=9;fontColor=#009900;strokeColor=#009900;entryPerimeter=0;" edge="1" parent="1" source="trips" target="trip-transport">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <!-- trip → schedule subcollection -->
        <mxCell id="arr-trip-schedule" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;exitX=1;exitY=0.7;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;fontSize=9;fontColor=#009900;strokeColor=#009900;entryPerimeter=0;" edge="1" parent="1" source="trips" target="trip-schedule">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <!-- trip → destinations (parallel reads) -->
        <mxCell id="arr-trip-dest" value="✅ parallel Promise.all()" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;exitX=1;exitY=0.2;exitDx=0;exitDy=0;entryX=0;entryY=0.3;entryDx=0;entryDy=0;fontSize=9;fontColor=#009900;strokeColor=#009900;strokeWidth=2;" edge="1" parent="1" source="trips" target="destinations">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <!-- trip → expenses -->
        <mxCell id="arr-trip-expense" value="1:1 by trip ID" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;exitX=0;exitY=0.85;exitDx=0;exitDy=0;entryX=1;entryY=0.3;entryDx=0;entryDy=0;fontSize=9;fontColor=#b85450;entryPerimeter=0;" edge="1" parent="1" source="trips" target="expenses">
