<mxfile host="app.diagrams.net" modified="2026-06-14T00:00:00.000Z" agent="Copilot" version="22.0.0">
  <diagram name="Option B - Optimized Redesign" id="option-b">
    <mxGraphModel dx="1400" dy="1000" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1600" pageHeight="1100" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />

        <!-- Title -->
        <mxCell id="title" value="Option B — Optimized Redesign (English names + subcollections)" style="text;html=1;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;whiteSpace=wrap;rounded=0;fontSize=18;fontStyle=1" vertex="1" parent="1">
          <mxGeometry x="250" y="20" width="900" height="40" as="geometry" />
        </mxCell>

        <!-- ==================== TOP-LEVEL COLLECTIONS ==================== -->
        <mxCell id="label-collections" value="Top-Level Collections" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;whiteSpace=wrap;rounded=0;fontSize=14;fontStyle=1" vertex="1" parent="1">
          <mxGeometry x="30" y="80" width="200" height="30" as="geometry" />
        </mxCell>

        <!-- users (slim) -->
        <mxCell id="users" value="users/{uid}&lt;br&gt;&lt;br&gt;✅ &lt;b&gt;SLIM — no embedded summaries&lt;/b&gt;&lt;br&gt;&lt;br&gt;• visibility: &quot;dynamic&quot;&lt;br&gt;• permissions: {...}&lt;br&gt;&lt;br&gt;&lt;i&gt;(was ~50+ KB, now ~200 bytes)&lt;/i&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=11;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;" vertex="1" parent="1">
          <mxGeometry x="30" y="120" width="260" height="120" as="geometry" />
        </mxCell>

        <!-- trips (lean) -->
        <mxCell id="trips" value="trips/{id}&lt;br&gt;&lt;br&gt;✅ &lt;b&gt;LEAN — only core + small embedded data&lt;/b&gt;&lt;br&gt;&lt;br&gt;• title, start, end, currency, pin&lt;br&gt;• version, colors, sharing, modules&lt;br&gt;• visibility, links, gallery&lt;br&gt;• travelers: [{id, name}]&lt;br&gt;&lt;br&gt;✅ &lt;b&gt;destinationRefs&lt;/b&gt;: [{id}]&lt;br&gt;&lt;i&gt;  (only IDs — fetched in parallel!)&lt;/i&gt;&lt;br&gt;&lt;br&gt;&lt;i&gt;(was ~200 KB, now ~5 KB)&lt;/i&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=10;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;" vertex="1" parent="1">
          <mxGeometry x="330" y="120" width="320" height="220" as="geometry" />
        </mxCell>

        <!-- destinations -->
        <mxCell id="destinations" value="destinations/{id}&lt;br&gt;&lt;br&gt;✅ &lt;b&gt;UNCHANGED structure&lt;/b&gt; (already good)&lt;br&gt;&lt;br&gt;• title, currency&lt;br&gt;• version, sharing, modules, myMaps&lt;br&gt;&lt;br&gt;• &lt;b&gt;restaurants&lt;/b&gt;: {id: PlaceItem}&lt;br&gt;• &lt;b&gt;snacks&lt;/b&gt;: {id: PlaceItem}&lt;br&gt;• &lt;b&gt;shops&lt;/b&gt;: {id: PlaceItem}&lt;br&gt;• &lt;b&gt;nightlife&lt;/b&gt;: {id: PlaceItem}&lt;br&gt;• &lt;b&gt;attractions&lt;/b&gt;: {id: PlaceItem}&lt;br&gt;&lt;br&gt;&lt;i&gt;(ID-keyed objects — O(1) access)&lt;/i&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=10;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;" vertex="1" parent="1">
          <mxGeometry x="690" y="120" width="300" height="240" as="geometry" />
        </mxCell>

        <!-- expenses -->
        <mxCell id="expenses" value="expenses/{tripId}&lt;br&gt;&lt;br&gt;• duringTrip: ExpenseEntry[]&lt;br&gt;• preTrip: ExpenseEntry[]&lt;br&gt;• budget: object" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=11;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;" vertex="1" parent="1">
          <mxGeometry x="30" y="280" width="260" height="80" as="geometry" />
        </mxCell>

        <!-- protected -->
        <mxCell id="protected" value="protected/{tripId}&lt;br&gt;&lt;br&gt;• pin: string&lt;br&gt;&lt;br&gt;── Subcollections ──&lt;br&gt;trips/protected/{pin}/{tripId}&lt;br&gt;expenses/protected/{pin}/{tripId}" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=10;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;" vertex="1" parent="1">
          <mxGeometry x="30" y="390" width="260" height="100" as="geometry" />
