          <mxGeometry x="40" y="668" width="240" height="40" as="geometry" />
        </mxCell>

        <!-- trip subcollections box -->
        <mxCell id="trip-subs-box" value="" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fef9e7;strokeColor=#d6b656;strokeWidth=1;dashed=1;" vertex="1" parent="1">
          <mxGeometry x="330" y="570" width="660" height="170" as="geometry" />
