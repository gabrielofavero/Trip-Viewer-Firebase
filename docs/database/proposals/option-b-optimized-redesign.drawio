          <mxGeometry x="690" y="390" width="300" height="100" as="geometry" />
        </mxCell>

        <!-- config -->
        <mxCell id="config" value="config/system&lt;br&gt;&lt;br&gt;• registrationOpen: boolean" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontSize=11;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;" vertex="1" parent="1">
          <mxGeometry x="690" y="520" width="200" height="60" as="geometry" />
        </mxCell>

        <!-- ==================== SUBCOLLECTIONS AREA ==================== -->
        <mxCell id="label-subcollections" value="🆕  Subcollections (was embedded in trip doc)" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;whiteSpace=wrap;rounded=0;fontSize=14;fontStyle=1;fontColor=#009900;" vertex="1" parent="1">
          <mxGeometry x="30" y="530" width="400" height="30" as="geometry" />
