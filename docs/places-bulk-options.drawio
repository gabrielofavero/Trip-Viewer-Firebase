          <mxGeometry x="640" y="316" width="720" height="46" as="geometry" />
        </mxCell>
        <mxCell id="c2g1" value="Google Places — official Google sources" style="rounded=1;arcSize=14;fillColor=#d5f5e3;strokeColor=#27ae60;fontColor=#145a32;fontStyle=1;whiteSpace=wrap;html=1;" vertex="1" parent="1">
          <mxGeometry x="640" y="382" width="340" height="54" as="geometry" />
        </mxCell>
        <mxCell id="c2l1" value="Local (gmaps scraper) — developer alternative, no API usage" style="rounded=1;arcSize=14;fillColor=#fff3cd;strokeColor=#f1c40f;fontColor=#6d4c00;fontStyle=1;whiteSpace=wrap;html=1;" vertex="1" parent="1">
          <mxGeometry x="1020" y="382" width="340" height="54" as="geometry" />
        </mxCell>
        <mxCell id="c2g2" value="runEnrichPending('api') — Places API Text Search per unlinked item" style="rounded=1;arcSize=8;fillColor=#ffffff;strokeColor=#999999;fontColor=#333333;whiteSpace=wrap;html=1;" vertex="1" parent="1">
          <mxGeometry x="640" y="452" width="340" height="66" as="geometry" />
        </mxCell>
        <mxCell id="c2l2" value="runEnrichPending('scraper') — local scrape per item (dev only)" style="rounded=1;arcSize=8;fillColor=#ffffff;strokeColor=#999999;fontColor=#333333;whiteSpace=wrap;html=1;" vertex="1" parent="1">
          <mxGeometry x="1020" y="452" width="340" height="66" as="geometry" />
        </mxCell>
        <mxCell id="c2g3" value="1 result → auto-select · multiple / none / error → review list" style="rounded=1;arcSize=8;fillColor=#ffffff;strokeColor=#999999;fontColor=#333333;whiteSpace=wrap;html=1;" vertex="1" parent="1">
          <mxGeometry x="640" y="534" width="340" height="54" as="geometry" />
        </mxCell>
        <mxCell id="c2l3" value="Matches always go to review (manual confirmation)" style="rounded=1;arcSize=8;fillColor=#ffffff;strokeColor=#999999;fontColor=#333333;whiteSpace=wrap;html=1;" vertex="1" parent="1">
          <mxGeometry x="1020" y="534" width="340" height="54" as="geometry" />
        </mxCell>
        <mxCell id="c2g4" value="Final review: ASK to include 1 photo per item — tag shows ≈ N photos" style="rounded=1;arcSize=8;fillColor=#ffffff;strokeColor=#999999;fontColor=#333333;whiteSpace=wrap;html=1;" vertex="1" parent="1">
          <mxGeometry x="640" y="604" width="340" height="54" as="geometry" />
        </mxCell>
        <mxCell id="c2l4" value="Final review: include photos BY DEFAULT (1 per item)" style="rounded=1;arcSize=8;fillColor=#ffffff;strokeColor=#999999;fontColor=#333333;whiteSpace=wrap;html=1;" vertex="1" parent="1">
          <mxGeometry x="1020" y="604" width="340" height="54" as="geometry" />
        </mxCell>
        <mxCell id="c2end" value="Review → Apply matched → Save" style="rounded=1;arcSize=8;fillColor=#d5f5e3;strokeColor=#27ae60;fontColor=#145a32;fontStyle=1;whiteSpace=wrap;html=1;" vertex="1" parent="1">
          <mxGeometry x="640" y="676" width="720" height="54" as="geometry" />
        </mxCell>

        <!-- ================= ALT Column 3: Refresh ================= -->
        <mxCell id="c3opt" value="Refresh — update the X items already enriched" style="rounded=1;arcSize=12;fillColor=#cfe8ff;strokeColor=#2e86de;fontColor=#083d77;fontStyle=1;whiteSpace=wrap;html=1;" vertex="1" parent="1">
          <mxGeometry x="1400" y="200" width="720" height="54" as="geometry" />
