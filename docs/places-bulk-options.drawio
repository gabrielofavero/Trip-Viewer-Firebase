        <mxCell id="c3obs" value="Obs: goes straight to the only available source · hidden if none available" style="rounded=1;arcSize=8;fillColor=#fdf2e9;strokeColor=#e67e22;fontColor=#6e2c00;fontSize=12;whiteSpace=wrap;html=1;" vertex="1" parent="1">
