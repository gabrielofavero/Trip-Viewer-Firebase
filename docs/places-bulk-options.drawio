          <mxGeometry x="1780" y="382" width="340" height="54" as="geometry" />
        </mxCell>
        <mxCell id="c3g2" value="runBulkPlacesUpdate() — getPlace() per linked item (info only, no photos)" style="rounded=1;arcSize=8;fillColor=#ffffff;strokeColor=#999999;fontColor=#333333;whiteSpace=wrap;html=1;" vertex="1" parent="1">
          <mxGeometry x="1400" y="452" width="340" height="66" as="geometry" />
        </mxCell>
        <mxCell id="c3l2" value="runBulkLocalUpdate() — scrapePlaces() one local request (sequential)" style="rounded=1;arcSize=8;fillColor=#ffffff;strokeColor=#999999;fontColor=#333333;whiteSpace=wrap;html=1;" vertex="1" parent="1">
          <mxGeometry x="1780" y="452" width="340" height="66" as="geometry" />
        </mxCell>
        <mxCell id="c3g3" value="Compare fresh vs stored → count updatable fields + closed places" style="rounded=1;arcSize=8;fillColor=#ffffff;strokeColor=#999999;fontColor=#333333;whiteSpace=wrap;html=1;" vertex="1" parent="1">
          <mxGeometry x="1400" y="534" width="340" height="54" as="geometry" />
        </mxCell>
        <mxCell id="c3l3" value="Report: updatable fields + closed places" style="rounded=1;arcSize=8;fillColor=#ffffff;strokeColor=#999999;fontColor=#333333;whiteSpace=wrap;html=1;" vertex="1" parent="1">
          <mxGeometry x="1780" y="534" width="340" height="54" as="geometry" />
