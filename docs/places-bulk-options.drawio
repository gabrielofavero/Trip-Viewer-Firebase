<mxfile host="app.diagrams.net" agent="Copilot" version="24.0.0" type="device">
  <diagram id="places-bulk-options" name="Bulk options flow">
    <mxGraphModel dx="0" dy="0" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="2250" pageHeight="900" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />

        <!-- Trigger -->
        <mxCell id="alt-trigger" value="Edit destination page — &quot;Enrich Data&quot; (bulk) button" style="rounded=1;arcSize=8;fillColor=#1e3a5f;strokeColor=#0f2440;fontColor=#ffffff;fontStyle=1;fontSize=14;whiteSpace=wrap;html=1;" vertex="1" parent="1">
          <mxGeometry x="700" y="20" width="900" height="50" as="geometry" />
        </mxCell>
        <mxCell id="alt-triggerNote" value="3 grouped actions (Add / Enrich / Refresh). Source choice (Google vs Local) moves inside Enrich/Refresh and auto-collapses to the only available source. The &quot;Enrich Data&quot; button is hidden when ALL sources (Places API + local scraper + My Maps) are disabled." style="text;html=1;fontSize=12;fontColor=#666666;whiteSpace=wrap;align=center;" vertex="1" parent="1">
          <mxGeometry x="700" y="72" width="900" height="42" as="geometry" />
        </mxCell>
        <mxCell id="alt-dialog" value="&quot;What would you like to do?&quot; — pick one of 3 grouped actions" style="rounded=1;arcSize=12;fillColor=#eef2f7;strokeColor=#9db2c9;fontColor=#222222;fontStyle=1;fontSize=13;whiteSpace=wrap;html=1;" vertex="1" parent="1">
          <mxGeometry x="700" y="130" width="900" height="40" as="geometry" />
        </mxCell>

        <!-- ================= ALT Column 1: Add (My Maps) ================= -->
        <mxCell id="c1opt" value="Add — Import every unused placemark from your My Maps link" style="rounded=1;arcSize=12;fillColor=#e8d5f5;strokeColor=#8e44ad;fontColor=#512e5f;fontStyle=1;whiteSpace=wrap;html=1;" vertex="1" parent="1">
          <mxGeometry x="40" y="200" width="560" height="54" as="geometry" />
        </mxCell>
        <mxCell id="c1obs" value="Obs: hidden if no My Maps link is available" style="rounded=1;arcSize=8;fillColor=#fdf2e9;strokeColor=#e67e22;fontColor=#6e2c00;fontSize=12;whiteSpace=wrap;html=1;" vertex="1" parent="1">
          <mxGeometry x="40" y="264" width="560" height="40" as="geometry" />
        </mxCell>
        <mxCell id="c1act" value="action: places-bulk-mymaps-reimport → openMymapsReimportDialog() — imports only unused placemarks" style="text;html=1;fontSize=11;fontStyle=2;fontColor=#512e5f;whiteSpace=wrap;align=center;" vertex="1" parent="1">
          <mxGeometry x="40" y="316" width="560" height="40" as="geometry" />
        </mxCell>
        <mxCell id="c1s1" value="Acquire KML: worker proxy via the myMaps link → .kml/.kmz upload fallback" style="rounded=1;arcSize=8;fillColor=#ffffff;strokeColor=#999999;fontColor=#333333;whiteSpace=wrap;html=1;" vertex="1" parent="1">
          <mxGeometry x="40" y="374" width="560" height="54" as="geometry" />
        </mxCell>
        <mxCell id="c1s2" value="Parse → drafts · keep only UNUSED placemarks (skip ones already in the destination)" style="rounded=1;arcSize=8;fillColor=#ffffff;strokeColor=#999999;fontColor=#333333;whiteSpace=wrap;html=1;" vertex="1" parent="1">
          <mxGeometry x="40" y="446" width="560" height="54" as="geometry" />
        </mxCell>
        <mxCell id="c1s3" value="Review dialog: one row per placemark (include checkbox, category select, status badge)" style="rounded=1;arcSize=8;fillColor=#ffffff;strokeColor=#999999;fontColor=#333333;whiteSpace=wrap;html=1;" vertex="1" parent="1">
          <mxGeometry x="40" y="518" width="560" height="50" as="geometry" />
        </mxCell>
        <mxCell id="c1s4" value="OPTIONAL enrich: Places API Text Search (location bias) or the local scraper" style="rounded=1;arcSize=8;fillColor=#ffffff;strokeColor=#999999;fontColor=#333333;whiteSpace=wrap;html=1;" vertex="1" parent="1">
          <mxGeometry x="40" y="586" width="560" height="54" as="geometry" />
        </mxCell>
        <mxCell id="c1s5" value="Conflict check: name or Maps link collides with an existing entry → keep both / skip / replace" style="rounded=1;arcSize=8;fillColor=#ffffff;strokeColor=#999999;fontColor=#333333;whiteSpace=wrap;html=1;" vertex="1" parent="1">
          <mxGeometry x="40" y="658" width="560" height="54" as="geometry" />
        </mxCell>
        <mxCell id="c1s6" value="Stage into edit form + pending data — no direct Firestore write" style="rounded=1;arcSize=8;fillColor=#ffffff;strokeColor=#999999;fontColor=#333333;whiteSpace=wrap;html=1;" vertex="1" parent="1">
          <mxGeometry x="40" y="730" width="560" height="50" as="geometry" />
        </mxCell>
        <mxCell id="c1end" value="Staged — click Save on the edit page to persist (also writes myMapsImported)" style="rounded=1;arcSize=8;fillColor=#d5f5e3;strokeColor=#27ae60;fontColor=#145a32;fontStyle=1;whiteSpace=wrap;html=1;" vertex="1" parent="1">
          <mxGeometry x="40" y="798" width="560" height="50" as="geometry" />
        </mxCell>

        <!-- ================= ALT Column 2: Enrich ================= -->
        <mxCell id="c2opt" value="Enrich — Add official info on manually added items" style="rounded=1;arcSize=12;fillColor=#fde2e2;strokeColor=#e74c3c;fontColor=#7b241c;fontStyle=1;whiteSpace=wrap;html=1;" vertex="1" parent="1">
          <mxGeometry x="640" y="200" width="720" height="54" as="geometry" />
        </mxCell>
        <mxCell id="c2obs" value="Obs: goes straight to the only available source · hidden if none available" style="rounded=1;arcSize=8;fillColor=#fdf2e9;strokeColor=#e67e22;fontColor=#6e2c00;fontSize=12;whiteSpace=wrap;html=1;" vertex="1" parent="1">
